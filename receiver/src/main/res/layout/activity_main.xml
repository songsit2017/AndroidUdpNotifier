<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receiver App is Running"
                android:gravity="center"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Permissions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#11000000"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔑 Permissions" android:textStyle="bold" android:layout_marginBottom="8dp"/>
                <Button android:id="@+id/btnRequestOverlay" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="1. Grant Overlay Permission" />
                <Button android:id="@+id/btnRequestBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="2. Grant Battery Exemption" />
                <Button android:id="@+id/btnRequestLocation" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="3. Grant Location Permission" />
            </LinearLayout>

            <!-- Communication -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#112196F3"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💬 Communication &amp; Messaging" android:textStyle="bold" android:textColor="#0D47A1" android:layout_marginBottom="8dp"/>
                
                <Switch android:id="@+id/switchQuickReply" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quick Replies" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงปุ่มตอบกลับด่วนบนจอรถ" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchTTS" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Text-to-Speech" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="อ่านข้อความที่ได้รับออกเสียงอัตโนมัติ" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchVIP" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="VIP Mode" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ทะลวงโหมดห้ามรบกวน หากมีคำว่า ด่วน/ฉุกเฉิน/สำคัญ" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchETA" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Share ETA" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงปุ่มส่งพิกัด GPS เมื่อมีคนทักถามตำแหน่ง" android:textSize="12sp" android:textColor="#666666" />
            </LinearLayout>

            <!-- Safety -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#11F44336"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️ Safety &amp; Health" android:textStyle="bold" android:textColor="#B71C1C" android:layout_marginBottom="8dp"/>
                
                <Switch android:id="@+id/switchFatigue" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fatigue Alert" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="เตือนพักสายตาและหาปั๊มเมื่อขับรถครบ 2 ชั่วโมง" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchSpeed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Speed Limit Warning" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="กะพริบจอแดงเตือนเมื่อขับเร็วเกิน 120 กม./ชม." android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchDND" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Do Not Disturb" android:checked="false"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="โหมดห้ามรบกวน (ปิดแจ้งเตือนทุกอย่างยกเว้น VIP)" android:textSize="12sp" android:textColor="#666666"/>
            </LinearLayout>

            <!-- Media -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#114CAF50"
                android:padding="12dp"
                android:layout_marginBottom="16dp">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎵 Media &amp; System" android:textStyle="bold" android:textColor="#1B5E20" android:layout_marginBottom="8dp"/>
                
                <Switch android:id="@+id/switchMedia" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Now Playing Overlay" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงเพลงที่กำลังเล่นและปุ่มควบคุม" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <Switch android:id="@+id/switchBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Battery Alerts" android:checked="true"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แจ้งเตือนเมื่อแบตมือถือต่ำกว่า 20%" android:textSize="12sp" android:textColor="#666666" android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theme:" android:textSize="16sp"/>
                    <Spinner android:id="@+id/spinnerTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnFindPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:backgroundTint="#F44336"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:text="🔍 ตามหามือถือ (ส่งเสียงร้อง)" />

        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#EEEEEE"
        android:padding="8dp">
        <TextView
            android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for UDP data..."
            android:textSize="12sp"
            android:fontFamily="monospace"/>
    </ScrollView>

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Check for Updates" />

    <TextView
        android:id="@+id/tvVersionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Version 1.0.0 | Created by Songsit"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="#888888" />

</LinearLayout>
