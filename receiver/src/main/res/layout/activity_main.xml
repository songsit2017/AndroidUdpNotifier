<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F7">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UdpReceiver"
                android:textAlignment="center"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1C1C1E"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="หน้าจอแสดงผลบนรถยนต์"
                android:textAlignment="center"
                android:textSize="14sp"
                android:textColor="#8E8E93"
                android:layout_marginBottom="24dp" />

            <!-- Permissions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions"
                        android:textStyle="bold"
                        android:textColor="#007AFF"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. GRANT OVERLAY PERMISSION"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestBattery"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. GRANT BATTERY EXEMPTION"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestLocation"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. GRANT LOCATION PERMISSION"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Features Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="General Features"
                        android:textStyle="bold"
                        android:textColor="#5856D6"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchQuickReply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Quick Replies"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงปุ่มตอบกลับด่วนบนจอรถ" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchTTS"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Text-to-Speech"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="อ่านข้อความที่ได้รับออกเสียงอัตโนมัติ" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Startup Greeting"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="พูดทักทายเมื่อสตาร์ทรถ" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchWeatherGreeting"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Weather &amp; PM 2.5 Greeting"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="รายงานสภาพอากาศตอนสตาร์ทรถ" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAudioDucking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Smart Audio Ducking"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="หรี่เสียงเพลงอัตโนมัติขณะระบบพูด" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoReply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Auto-Reply While Driving"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ส่งข้อความตอบกลับอัตโนมัติเมื่อขับรถอยู่" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchVIP"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="VIP Mode"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="ทะลวงโหมดห้ามรบกวน หากมีคำว่า ด่วน/ฉุกเฉิน/สำคัญ" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchETA"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Share ETA"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงปุ่มส่งพิกัด GPS เมื่อมีคนทักถามตำแหน่ง" android:textSize="12sp" android:textColor="#8E8E93" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Safety Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safety &amp; Health"
                        android:textStyle="bold"
                        android:textColor="#FF3B30"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFatigue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Fatigue Alert"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="เตือนพักสายตาและหาปั๊มเมื่อขับรถครบ 2 ชั่วโมง" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Speed Limit Warning"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="กะพริบจอแดงเตือนเมื่อขับเร็วเกิน 120 กม./ชม." android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchDND"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Do Not Disturb"
                        android:checked="false" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="โหมดห้ามรบกวน (ปิดแจ้งเตือนทุกอย่างยกเว้น VIP)" android:textSize="12sp" android:textColor="#8E8E93" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Media Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Media &amp; System"
                        android:textStyle="bold"
                        android:textColor="#34C759"
                        android:textSize="16sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchMedia"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Now Playing Overlay"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แสดงเพลงที่กำลังเล่นและปุ่มควบคุม" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchBattery"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Battery Alerts"
                        android:checked="true" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="แจ้งเตือนเมื่อแบตมือถือต่ำกว่า 20%" android:textSize="12sp" android:textColor="#8E8E93" android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Theme:" android:textSize="16sp" android:textColor="#1C1C1E"/>
                        <Spinner android:id="@+id/spinnerTheme" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Popup Position:" android:textSize="16sp" android:textColor="#1C1C1E"/>
                        <Spinner android:id="@+id/spinnerPopupPosition" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddGeoReminder"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FF9500"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:cornerRadius="12dp"
                android:text="📍 ตั้งเตือนพิกัดปัจจุบัน (Geo-Reminder)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindPhone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FF3B30"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                app:cornerRadius="12dp"
                android:text="🔍 ตามหามือถือ (ส่งเสียงร้อง)" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#E5E5EA">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for UDP data..."
                android:textSize="12sp"
                android:textColor="#8E8E93"
                android:fontFamily="monospace"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckUpdate"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#007AFF"
        android:text="Check for Updates" />

    <TextView
        android:id="@+id/tvVersionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Version 1.0.0 | Created by Songsit2017 x PUPU"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textColor="#AEAEB2" />

</LinearLayout>
