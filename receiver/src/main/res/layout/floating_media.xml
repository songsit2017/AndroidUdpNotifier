<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact media player card — album art as blurred background, dark overlay,
    song + artist text on top, prev/play/next controls at bottom.
    Height is intentionally kept compact (~130 dp) to avoid blocking the screen.
-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_margin="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FF000000">

    <!-- Root FrameLayout to layer: album art → overlay → content -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Album art stretched as card background -->
        <ImageView
            android:id="@+id/mediaAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.55" />

        <!-- Dark gradient overlay for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- All content on top -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <!-- Row 1: App icon · App name (no close button — use swipe to dismiss) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/mediaAppIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:scaleType="fitCenter"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mediaAppName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Music"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- Row 2: Song title (large, marquee) -->
            <TextView
                android:id="@+id/mediaSongTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Song Title"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true" />

            <!-- Row 3: Artist name -->
            <TextView
                android:id="@+id/mediaArtistName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Artist"
                android:textColor="#BBFFFFFF"
                android:textSize="13sp"
                android:fontFamily="sans-serif"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Row 4: Playback controls — ⏮  ◉▶/⏸◉  ⏭  centered -->
            <LinearLayout
                android:id="@+id/mediaControlsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/mediaPrevBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_previous"
                    android:tint="#DDFFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <!-- Play/Pause — filled orange circle -->
                <ImageButton
                    android:id="@+id/mediaPlayBtn"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:src="@drawable/ic_media_play_pause"
                    android:tint="#FFFFFFFF"
                    android:padding="12dp"
                    android:scaleType="fitCenter" />

                <ImageButton
                    android:id="@+id/mediaNextBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_next"
                    android:tint="#DDFFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
