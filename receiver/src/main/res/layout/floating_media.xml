<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="400dp"
    android:layout_height="64dp"
    android:layout_gravity="center_horizontal"
    android:layout_margin="12dp"
    app:cardCornerRadius="32dp"
    app:cardElevation="16dp"
    app:cardBackgroundColor="#FF000000">

    <FrameLayout
        android:layout_width="400dp"
        android:layout_height="64dp">

        <!-- Album art stretched as card background -->
        <ImageView
            android:id="@+id/mediaAlbumArt"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:alpha="0.55" />

        <!-- Dark gradient overlay for readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/mediaAppIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Song Title and Artist (Marquee) -->
            <TextView
                android:id="@+id/mediaSongTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Song Title - Artist"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:layout_marginEnd="12dp" />

            <!-- Artist TextView kept but hidden to prevent logic crashes if it's referenced in code, 
                 or we can just hide it and combine the text into mediaSongTitle in code -->
            <TextView
                android:id="@+id/mediaArtistName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
                
            <TextView
                android:id="@+id/mediaAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Playback controls -->
            <LinearLayout
                android:id="@+id/mediaControlsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/mediaPrevBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_previous"
                    android:tint="#DDFFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />

                <!-- Play/Pause -->
                <ImageButton
                    android:id="@+id/mediaPlayBtn"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_media_play_pause"
                    android:tint="#FFFFFFFF"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:background="?attr/selectableItemBackgroundBorderless" />

                <ImageButton
                    android:id="@+id/mediaNextBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_media_next"
                    android:tint="#DDFFFFFF"
                    android:padding="8dp"
                    android:scaleType="fitCenter" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
