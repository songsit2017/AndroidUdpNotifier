<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/app_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UdpReceiver"
                android:textAlignment="center"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/app_text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="หน้าจอแสดงผลบนรถยนต์"
                android:textAlignment="center"
                android:textSize="24sp"
                android:textColor="@color/app_text_secondary"
                android:layout_marginBottom="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowPairingQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                app:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:text="แสดง QR สำหรับจับคู่" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="สถานะ: รอการเชื่อมต่อ"
                android:textAlignment="center"
                android:textColor="@color/app_text_secondary" />

            <!-- Permissions Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permissions"
                        android:textStyle="bold"
                        android:textColor="@color/app_accent"
                        android:textSize="20sp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestOverlay"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. GRANT OVERLAY PERMISSION"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestBattery"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. GRANT BATTERY EXEMPTION"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRequestLocation"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="3. GRANT LOCATION PERMISSION"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="@color/app_surface"
                android:textColor="@color/app_text_primary"
                android:textSize="18sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/app_accent"
                app:strokeWidth="2dp"
                android:text="การตั้งค่าระบบ (Settings)" />


            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddGeoReminder"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FF9500"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="12dp"
                android:text="📍 ตั้งเตือนพิกัดปัจจุบัน (Geo-Reminder)" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFindPhone"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#FF3B30"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                app:cornerRadius="12dp"
                android:text="🔍 ตามหามือถือ (ส่งเสียงร้อง)" />


    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/app_surface">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Connection Health"
                android:textStyle="bold"
                android:textColor="@color/app_accent"
                android:textSize="24sp" />
            <TextView
                android:id="@+id/tvDiagnosticsHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:text="กำลังตรวจสอบการเชื่อมต่อ..."
                android:textColor="@color/app_text_secondary" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTestSystem"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ทดสอบ Popup และเสียง"
                android:textColor="@color/app_accent"
                app:strokeColor="@color/app_accent" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportDiagnostics"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ส่งออก Diagnostic Log"
                android:textColor="@color/app_accent" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginHorizontal="16dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/app_surface_muted">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting for UDP data..."
                android:textSize="20sp"
                android:textColor="@color/app_text_secondary"
                android:fontFamily="monospace"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckUpdate"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/app_accent"
        android:text="Check for Updates" />

    <TextView
        android:id="@+id/tvVersionInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Version 1.0.0 | Created by Songsit2017 x PUPU"
        android:textAlignment="center"
        android:textSize="20sp"
        android:textColor="@color/app_text_secondary" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
